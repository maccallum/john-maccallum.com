---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
{%- if p.sitemap == false or p.url contains ".css" or p.url contains ".xml" or p.url contains ".txt" %}{% continue %}{% endif %}
  <url><loc>{{ p.url | absolute_url }}</loc></url>
{%- endfor %}
{%- for w in site.works %}
  <url><loc>{{ w.url | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
